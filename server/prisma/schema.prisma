// Prisma schema for the Collectible Card Exchange Platform V0.
// SQLite is used for deterministic, dependency-free local development.
// See docs/architecture.md for the rationale behind this domain model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  /// Unguessable token used to address this collector in matches and
  /// exchanges. Not the auth subject, not shown on public share pages.
  publicId     String   @unique
  /// Bumped when the password changes or the account signs out.
  /// Tokens carry this value and stop working when it no longer matches.
  sessionVersion Int    @default(0)
  createdAt    DateTime @default(now())

  copies             UserCopy[]
  copyImages         CopyImage[]
  personalCards      PersonalCard[]
  personalCopies     PersonalCopy[]
  collectionShares   CollectionShare[]
  proposedExchanges  Exchange[] @relation("ExchangeProposer")
  receivedExchanges  Exchange[] @relation("ExchangeCounterparty")

  @@map("users")
}

/// A collectible brand/game, e.g. "One Piece Card Game", "Pokémon TCG".
/// Kept generic so new universes can be added without schema changes.
model CollectibleUniverse {
  id   String @id @default(cuid())
  name String
  slug String @unique

  sets Set[]

  @@map("collectible_universes")
}

/// A released set/expansion within a universe.
model Set {
  id          String    @id @default(cuid())
  providerId  String? // external catalog identifier, if sourced from a CatalogProvider
  name        String
  code        String    @unique
  releaseDate DateTime?

  universeId String
  universe   CollectibleUniverse @relation(fields: [universeId], references: [id])

  collectibles     Collectible[]
  collectionShares CollectionShare[]
  exchanges        Exchange[]

  @@map("sets")
}

/// A single card/sticker/entry within a set. Distinct from Variant: a
/// Collectible is "what number/name this card is", a Variant is "which
/// physical print of it". Set completion is measured over Collectibles.
model Collectible {
  id         String  @id @default(cuid())
  providerId String?
  number     String
  name       String
  rarity     String?
  metadata   String? // JSON-encoded free-form attributes (color, type, etc.)

  setId String
  set   Set    @relation(fields: [setId], references: [id])

  variants Variant[]

  @@unique([setId, number])
  @@map("collectibles")
}

/// An alternate physical print of a Collectible (base, alt art, manga
/// rare, reprint, language variant, ...). V0 seeds one default Variant
/// per Collectible but the model does not assume that cardinality.
model Variant {
  id        String  @id @default(cuid())
  name      String
  isDefault Boolean @default(true)

  collectibleId String
  collectible   Collectible @relation(fields: [collectibleId], references: [id])

  userCopies UserCopy[]

  @@unique([collectibleId, name])
  @@map("variants")
}

/// SQLite has no native enum type, so availability is stored as a
/// string constrained to KEEP | TRADE | SELL | GIVE_AWAY by the zod
/// schemas at the API boundary (see modules/collection/routes.ts).
/// One physical copy owned by one user. Multiple UserCopy rows for the
/// same Variant + owner represent duplicates.
model UserCopy {
  id           String   @id @default(cuid())
  availability String   @default("KEEP")
  condition    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  variantId String
  variant   Variant @relation(fields: [variantId], references: [id])

  /// Set while this copy is committed to a PROPOSED or ACCEPTED exchange.
  /// Cleared on decline, cancel, or completion. Null means the copy is free
  /// to offer again.
  reservedByExchangeId String?
  reservedByExchange   Exchange? @relation(fields: [reservedByExchangeId], references: [id])

  exchangeLines ExchangeLine[]
  images        CopyImage[]

  @@map("user_copies")
}

/// A private photo of one physical copy. Front and back are separate rows.
/// The file is not a catalog image, and it is not proof of ownership.
model CopyImage {
  id          String   @id @default(cuid())
  side        String
  contentType String
  byteLength  Int
  createdAt   DateTime @default(now())

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  copyId String
  copy   UserCopy @relation(fields: [copyId], references: [id], onDelete: Cascade)

  @@unique([copyId, side])
  @@index([ownerId])
  @@map("copy_images")
}

/// A real card the signed-in person typed. It is not a catalog row.
/// Other accounts cannot search it, share it, or match it.
/// Raw strings stay as typed. Working strings are what the owner sees after a correction.
model PersonalCard {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  rawName    String
  rawGame    String
  rawSetName String
  rawNumber  String?
  noNumber   Boolean

  name    String
  game    String
  setName String
  number  String?

  rawSetCode  String?
  setCode     String?
  rawRarity   String?
  rarity      String?
  rawLanguage String?
  language    String?

  /// Private duplicate key. Never returned to another account.
  normalizedKey String
  /// Zero for the first note with this key. Higher only when the owner said a no-number card is a different card.
  disambiguator Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  copies PersonalCopy[]

  @@unique([ownerId, normalizedKey, disambiguator])
  @@index([ownerId])
  @@map("personal_cards")
}

/// One physical object the owner typed. It cannot be reserved for an exchange.
/// A photo of the printed card is not stored here.
model PersonalCopy {
  id           String   @id @default(cuid())
  availability String   @default("KEEP")
  condition    String?
  rawPrinting  String?
  printing     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  personalCardId String
  personalCard   PersonalCard @relation(fields: [personalCardId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([personalCardId])
  @@map("personal_copies")
}

/// A user's public-sharing configuration for one Set. At most one row per
/// (owner, set) — see modules/sharing. `shareId` is the public, guessable-
/// resistant identifier used in the public URL; it is deliberately a
/// separate random token from `id` (the internal row id) so it can be
/// rotated ("regenerate") without disturbing the row's identity or the
/// owner's saved visibility preferences. `enabled` turns the link on or
/// off. A disabled row's shareId resolves to 404, never to a "sharing is
/// off" response, so a client can't distinguish a revoked link from one
/// that never existed. `expiresAt` is checked too: a past or missing time
/// is the same 404 while sharing is on.
model CollectionShare {
  id      String  @id @default(cuid())
  shareId String  @unique
  enabled Boolean @default(false)
  /// End of the public link. Null while sharing is off. Renewing keeps
  /// shareId and sets a new time; regenerating also starts a new window.
  expiresAt DateTime?
  /// Successful loads of the public page. Not who opened it.
  viewCount    Int       @default(0)
  /// When the public page was last loaded. Null when it never has been.
  lastViewedAt DateTime?

  showCompletion Boolean @default(true)
  showOwned      Boolean @default(true)
  showMissing    Boolean @default(true)
  showDuplicates Boolean @default(true)
  showTrade      Boolean @default(true)
  showGiveAway   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  setId String
  set   Set    @relation(fields: [setId], references: [id])

  @@unique([ownerId, setId])
  @@map("collection_shares")
}

/// A proposed trade or donation between two collectors for one set.
/// There is no message body: an exchange is a structured offer only.
/// Status is constrained in domain/exchange.ts to
/// PROPOSED | ACCEPTED | DECLINED | CANCELLED | COMPLETED.
/// Type is MUTUAL_TRADE | DONATION.
model Exchange {
  id     String @id @default(cuid())
  type   String
  status String

  setId String
  set   Set    @relation(fields: [setId], references: [id])

  proposerId String
  proposer   User   @relation("ExchangeProposer", fields: [proposerId], references: [id])

  counterpartyId String
  counterparty   User   @relation("ExchangeCounterparty", fields: [counterpartyId], references: [id])

  proposerConfirmedAt     DateTime?
  counterpartyConfirmedAt DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  /// Set when the exchange leaves the open states (decline, cancel, complete).
  closedAt                DateTime?

  lines          ExchangeLine[]
  reservedCopies UserCopy[]

  @@index([setId, status])
  @@index([proposerId, status])
  @@index([counterpartyId, status])
  @@map("exchanges")
}

/// One physical copy committed to an exchange, with a snapshot of the
/// catalog label and the user-entered condition at proposal time. `copyId`
/// is nullable so deleting a copy later (after the exchange is closed)
/// keeps the historical label instead of taking the exchange row with it.
model ExchangeLine {
  id String @id @default(cuid())

  exchangeId String
  exchange   Exchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)

  copyId String?
  copy   UserCopy? @relation(fields: [copyId], references: [id], onDelete: SetNull)

  fromUserId        String
  toUserId          String
  collectibleNumber String
  collectibleName   String
  rarity            String?
  condition         String?

  @@index([exchangeId])
  @@map("exchange_lines")
}
