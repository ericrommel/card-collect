{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src", "prisma", "tests"],
  // These tests import web modules, which sit outside rootDir.
  "exclude": [
    "tests/domain/duplicateOffers.test.ts",
    "tests/domain/explorerDetail.test.ts",
    "tests/domain/collectionFocus.test.ts",
    "tests/domain/conditionSummary.test.ts",
    "tests/domain/dashboardSets.test.ts",
    "tests/domain/publicShareBrowse.test.ts",
    "tests/domain/exchangeQueue.test.ts"
  ]
}
